#export open

#include "raylib.h"

#define PLAYER_HEIGHT 80

#define PLAYER_WIDTH 10

#define PLAYER_OFFSET 0.036f

#define BALL_SIZE 10

#define BALL_SPEED 150.0f

#define SCREEN_HEIGHT 600

#define SCREEN_WIDTH 800

#define TIME_PAUSED 0.5f

struct player {
    Vector2 position;
    float velocity;
    int score;
};

struct ball {
    Vector2 position;
    Vector2 velocity;
};

struct timer {
   float time;
   bool active; 
};

struct game_state {
    struct player player1;
    struct player player2;
    struct ball ball;
    struct timer timer;
};

#export close
